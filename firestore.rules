rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Core Identity & Validation Primitives
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'ssuspect542@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateId(dateId) {
      return dateId is string && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (No existing()/diff() references here)
    // -------------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['id', 'studentId', 'name', 'email', 'state', 'district', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'studentId', 'name', 'email', 'phone', 'state', 'district',
          'targetExam', 'batch', 'dailyStreak', 'streakFreezes', 'skillTier',
          'referralCode', 'referredBy', 'badges', 'role', 'createdAt', 'updatedAt'
        ])
        && data.id == userId
        && isValidId(data.studentId) && data.studentId.size() <= 64
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 128
        && data.state is string && data.state.size() > 0 && data.state.size() <= 80
        && data.district is string && data.district.size() > 0 && data.district.size() <= 80
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 24))
        && (!('targetExam' in data) || (data.targetExam is string && data.targetExam.size() <= 80))
        && (!('batch' in data) || (data.batch is string && data.batch.size() <= 80))
        && (!('dailyStreak' in data) || (data.dailyStreak is number && data.dailyStreak >= 0 && data.dailyStreak <= 3650))
        && (!('streakFreezes' in data) || (data.streakFreezes is number && data.streakFreezes >= 0 && data.streakFreezes <= 10))
        && (!('skillTier' in data) || data.skillTier in ['Bronze', 'Silver', 'Gold', 'Grandmaster'])
        && (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 64))
        && (!('referredBy' in data) || (data.referredBy is string && data.referredBy.size() <= 64))
        && (!('badges' in data) || (data.badges is list && data.badges.size() <= 25 && (data.badges.size() == 0 || data.badges[0] is string)))
        && data.role in ['student', 'admin', 'superAdmin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProgress(data, userId) {
      return data.keys().hasAll(['userId', 'testsTaken', 'currentStreak', 'skillTier', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'testsTaken', 'averageScore', 'highestScore', 'overallAccuracy',
          'bestRank', 'currentStreak', 'longestStreak', 'streakFreezesAvailable',
          'streakFreezesUsed', 'frozenDates', 'claimedMilestones', 'lastActivityDate',
          'lastFreezeConsumedDate', 'skillTier', 'xpPoints', 'proAnalyticsUnlocked',
          'referralsCount', 'badges', 'marksLostToNegatives', 'rapidMistakesCount',
          'subjectPerformance', 'weakestTopics', 'recentAttempts', 'rolling30DayHistory',
          'updatedAt'
        ])
        && data.userId == userId
        && data.testsTaken is number && data.testsTaken >= 0 && data.testsTaken <= 50000
        && (!('averageScore' in data) || (data.averageScore is number && data.averageScore >= -200 && data.averageScore <= 1000))
        && (!('highestScore' in data) || (data.highestScore is number && data.highestScore >= -200 && data.highestScore <= 1000))
        && (!('overallAccuracy' in data) || (data.overallAccuracy is number && data.overallAccuracy >= 0 && data.overallAccuracy <= 100))
        && (!('bestRank' in data) || (data.bestRank is number && data.bestRank >= 0))
        && data.currentStreak is number && data.currentStreak >= 0 && data.currentStreak <= 3650
        && (!('longestStreak' in data) || (data.longestStreak is number && data.longestStreak >= 0 && data.longestStreak <= 3650))
        && (!('streakFreezesAvailable' in data) || (data.streakFreezesAvailable is number && data.streakFreezesAvailable >= 0 && data.streakFreezesAvailable <= 10))
        && (!('streakFreezesUsed' in data) || (data.streakFreezesUsed is number && data.streakFreezesUsed >= 0 && data.streakFreezesUsed <= 1000))
        && (!('frozenDates' in data) || (data.frozenDates is list && data.frozenDates.size() <= 90 && (data.frozenDates.size() == 0 || data.frozenDates[0] is string)))
        && (!('claimedMilestones' in data) || (data.claimedMilestones is list && data.claimedMilestones.size() <= 20 && (data.claimedMilestones.size() == 0 || data.claimedMilestones[0] is number)))
        && (!('lastActivityDate' in data) || (data.lastActivityDate is string && data.lastActivityDate.size() <= 20))
        && (!('lastFreezeConsumedDate' in data) || (data.lastFreezeConsumedDate is string && data.lastFreezeConsumedDate.size() <= 20))
        && data.skillTier in ['Bronze', 'Silver', 'Gold', 'Grandmaster']
        && (!('xpPoints' in data) || (data.xpPoints is number && data.xpPoints >= 0 && data.xpPoints <= 10000000))
        && (!('proAnalyticsUnlocked' in data) || data.proAnalyticsUnlocked is bool)
        && (!('referralsCount' in data) || (data.referralsCount is number && data.referralsCount >= 0 && data.referralsCount <= 10000))
        && (!('badges' in data) || (data.badges is list && data.badges.size() <= 30 && (data.badges.size() == 0 || data.badges[0] is string)))
        && (!('marksLostToNegatives' in data) || (data.marksLostToNegatives is number && data.marksLostToNegatives >= 0))
        && (!('rapidMistakesCount' in data) || (data.rapidMistakesCount is number && data.rapidMistakesCount >= 0))
        && (!('subjectPerformance' in data) || (data.subjectPerformance is list && data.subjectPerformance.size() <= 10 && (data.subjectPerformance.size() == 0 || data.subjectPerformance[0] is map)))
        && (!('weakestTopics' in data) || (data.weakestTopics is list && data.weakestTopics.size() <= 20 && (data.weakestTopics.size() == 0 || data.weakestTopics[0] is map)))
        && (!('recentAttempts' in data) || (data.recentAttempts is list && data.recentAttempts.size() <= 35 && (data.recentAttempts.size() == 0 || data.recentAttempts[0] is map)))
        && (!('rolling30DayHistory' in data) || (data.rolling30DayHistory is list && data.rolling30DayHistory.size() <= 35 && (data.rolling30DayHistory.size() == 0 || data.rolling30DayHistory[0] is map)))
        && data.updatedAt is timestamp;
    }

    function isValidAttempt(data, userId, attemptId) {
      return data.keys().hasAll([
          'id', 'userId', 'studentId', 'studentName', 'studentState',
          'testId', 'score', 'correctCount', 'incorrectCount',
          'unattemptedCount', 'timeTakenSeconds', 'isDisqualified', 'submittedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'studentId', 'studentName', 'studentState',
          'testId', 'score', 'correctCount', 'incorrectCount',
          'unattemptedCount', 'timeTakenSeconds', 'isDisqualified', 'submittedAt'
        ])
        && data.id == attemptId
        && data.userId == userId
        && isValidId(data.studentId) && data.studentId.size() <= 64
        && data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 120
        && data.studentState is string && data.studentState.size() > 0 && data.studentState.size() <= 80
        && isValidId(data.testId) && data.testId.size() <= 64
        && data.score is number && data.score >= -100 && data.score <= 400
        && data.correctCount is number && data.correctCount >= 0 && data.correctCount <= 200
        && data.incorrectCount is number && data.incorrectCount >= 0 && data.incorrectCount <= 200
        && data.unattemptedCount is number && data.unattemptedCount >= 0 && data.unattemptedCount <= 200
        && data.timeTakenSeconds is number && data.timeTakenSeconds >= 0 && data.timeTakenSeconds <= 7200
        && data.isDisqualified is bool
        && data.submittedAt is timestamp;
    }

    function isValidLeaderboardEntry(data, studentId) {
      return data.keys().hasAll(['id', 'userId', 'studentId', 'studentName', 'studentState', 'testId', 'score', 'correctCount', 'incorrectCount', 'unattemptedCount', 'timeTakenSeconds', 'submittedAt'])
        && data.keys().hasOnly(['id', 'userId', 'studentId', 'studentName', 'studentState', 'testId', 'score', 'correctCount', 'incorrectCount', 'unattemptedCount', 'timeTakenSeconds', 'skillTier', 'isDisqualified', 'submittedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId == request.auth.uid
        && data.studentId == studentId && isValidId(data.studentId) && data.studentId.size() <= 64
        && data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 120
        && data.studentState is string && data.studentState.size() > 0 && data.studentState.size() <= 80
        && data.testId is string && data.testId.size() > 0 && data.testId.size() <= 64
        && data.score is number && data.score >= -100 && data.score <= 400
        && data.correctCount is number && data.correctCount >= 0 && data.correctCount <= 200
        && data.incorrectCount is number && data.incorrectCount >= 0 && data.incorrectCount <= 200
        && data.unattemptedCount is number && data.unattemptedCount >= 0 && data.unattemptedCount <= 200
        && data.timeTakenSeconds is number && data.timeTakenSeconds >= 0 && data.timeTakenSeconds <= 7200
        && (!('skillTier' in data) || data.skillTier in ['Bronze', 'Silver', 'Gold', 'Grandmaster'])
        && (!('isDisqualified' in data) || data.isDisqualified is bool)
        && data.submittedAt is timestamp;
    }

    function isValidScheduledTest(data, testId) {
      return data.keys().hasAll(['id', 'title', 'testType', 'scheduledDate', 'durationSeconds', 'status', 'createdBy', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'description', 'testType', 'scheduledDate', 'scheduledStartTime', 'scheduledEndTime', 'durationSeconds', 'status', 'questions', 'createdBy', 'updatedAt'])
        && data.id == testId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && data.testType in ['daily', 'custom']
        && isValidDateId(data.scheduledDate)
        && (!('scheduledStartTime' in data) || (data.scheduledStartTime is string && data.scheduledStartTime.size() <= 12))
        && (!('scheduledEndTime' in data) || (data.scheduledEndTime is string && data.scheduledEndTime.size() <= 12))
        && data.durationSeconds is number && data.durationSeconds > 0 && data.durationSeconds <= 7200
        && data.status in ['draft', 'validated', 'scheduled', 'live', 'closed', 'published']
        && (!('questions' in data) || (data.questions is list && data.questions.size() <= 200 && (data.questions.size() == 0 || data.questions[0] is map)))
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidPQP(data, pqpId) {
      return data.keys().hasAll(['id', 'title', 'examCategory', 'year', 'durationSeconds', 'questions', 'uploadedBy', 'uploadedAt'])
        && data.keys().hasOnly(['id', 'title', 'examCategory', 'year', 'shiftLabel', 'durationSeconds', 'questions', 'uploadedBy', 'uploadedAt'])
        && data.id == pqpId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.examCategory is string && data.examCategory.size() > 0 && data.examCategory.size() <= 80
        && data.year is number && data.year >= 1990 && data.year <= 2100
        && (!('shiftLabel' in data) || (data.shiftLabel is string && data.shiftLabel.size() <= 60))
        && data.durationSeconds is number && data.durationSeconds > 0 && data.durationSeconds <= 7200
        && data.questions is list && data.questions.size() > 0 && data.questions.size() <= 200 && data.questions[0] is map
        && data.uploadedBy is string && data.uploadedBy.size() <= 128
        && data.uploadedAt is timestamp;
    }

    function isValidKeySheet(data, examDate) {
      return data.keys().hasAll(['examDate', 'title', 'unlockTimestampMs', 'items', 'publishedBy', 'updatedAt'])
        && data.keys().hasOnly(['examDate', 'title', 'unlockTimestampMs', 'items', 'publishedBy', 'updatedAt'])
        && data.examDate == examDate && isValidDateId(examDate)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.unlockTimestampMs is number && data.unlockTimestampMs > 0
        && data.items is list && data.items.size() <= 200 && (data.items.size() == 0 || data.items[0] is map)
        && data.publishedBy is string && data.publishedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data, logId) {
      return data.keys().hasAll(['id', 'actorUid', 'eventType', 'action', 'details', 'timestamp'])
        && data.keys().hasOnly(['id', 'actorUid', 'eventType', 'action', 'details', 'timestamp'])
        && data.id == logId
        && data.actorUid == request.auth.uid
        && data.eventType is string && data.eventType.size() > 0 && data.eventType.size() <= 64
        && data.action is string && data.action.size() > 0 && data.action.size() <= 120
        && data.details is string && data.details.size() <= 500
        && data.timestamp is timestamp;
    }

    function isValidSpeedPracticeSession(data, userId, sessionId) {
      return data.keys().hasAll(['id', 'userId', 'totalQuestions', 'correctCount', 'accuracy', 'completedAt'])
        && data.keys().hasOnly([
          'id', 'userId', 'examCategory', 'subject', 'difficulty', 'poolFilter',
          'totalQuestions', 'correctCount', 'incorrectCount', 'accuracy',
          'avgTimePerQuestionSec', 'completedAt'
        ])
        && data.id == sessionId
        && data.userId == userId
        && (!('examCategory' in data) || (data.examCategory is string && data.examCategory.size() <= 80))
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 80))
        && (!('difficulty' in data) || data.difficulty in ['all', 'easy', 'medium', 'hard'])
        && (!('poolFilter' in data) || data.poolFilter in ['all', 'incorrect', 'unattempted'])
        && data.totalQuestions is number && data.totalQuestions >= 1 && data.totalQuestions <= 200
        && data.correctCount is number && data.correctCount >= 0 && data.correctCount <= 200
        && (!('incorrectCount' in data) || (data.incorrectCount is number && data.incorrectCount >= 0 && data.incorrectCount <= 200))
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
        && (!('avgTimePerQuestionSec' in data) || (data.avgTimePerQuestionSec is number && data.avgTimePerQuestionSec >= 0 && data.avgTimePerQuestionSec <= 600))
        && data.completedAt is timestamp;
    }

    function isValidStudyPlanOverride(data, dayKey) {
      return data.keys().hasAll(['dayKey', 'approvalStatus', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly([
          'dayKey', 'subject', 'topic', 'topicDescription',
          'learningObjectives', 'approvalStatus', 'scheduledDateOverride',
          'updatedBy', 'updatedAt'
        ])
        && data.dayKey == dayKey
        && dayKey.matches('^W[0-9]{3}_D[1-7]$')
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 80))
        && (!('topic' in data) || (data.topic is string && data.topic.size() <= 200))
        && (!('topicDescription' in data) || (data.topicDescription is string && data.topicDescription.size() <= 600))
        && (!('learningObjectives' in data) || (data.learningObjectives is list && data.learningObjectives.size() <= 10 && (data.learningObjectives.size() == 0 || data.learningObjectives[0] is string)))
        && data.approvalStatus in ['approved', 'pending_review', 'rescheduled']
        && (!('scheduledDateOverride' in data) || isValidDateId(data.scheduledDateOverride))
        && data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidAIMCQQuestion(data, questionId) {
      return data.keys().hasAll(['id', 'text', 'options', 'correctIndex', 'subject', 'topic', 'difficulty', 'examCategory', 'reviewStatus', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'text', 'options', 'correctIndex', 'explanation', 'subject', 'topic',
          'difficulty', 'examCategory', 'reviewStatus', 'sourceType', 'referenceNote', 'updatedAt'
        ])
        && data.id == questionId
        && data.text is string && data.text.size() >= 10 && data.text.size() <= 2000
        && data.options is list && data.options.size() == 4 && data.options[0] is string
        && data.correctIndex is number && data.correctIndex >= 0 && data.correctIndex <= 3
        && (!('explanation' in data) || (data.explanation is string && data.explanation.size() <= 2000))
        && data.subject is string && data.subject.size() <= 80
        && data.topic is string && data.topic.size() <= 160
        && data.difficulty in ['easy', 'medium', 'hard']
        && data.examCategory is string && data.examCategory.size() <= 80
        && data.reviewStatus in ['pending', 'approved', 'rejected']
        && (!('sourceType' in data) || data.sourceType in ['ai_generated', 'admin_curated', 'verified_pqp'])
        && (!('referenceNote' in data) || (data.referenceNote is string && data.referenceNote.size() <= 200))
        && data.updatedAt is timestamp;
    }

    function isValidAppPublicSettings(data, settingId) {
      return data.keys().hasAll(['id', 'examStartTime', 'examEndTime', 'answerKeyReleaseTime', 'leaderboardVisibility', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'questionGenerationTime', 'examStartTime', 'examEndTime',
          'answerKeyReleaseTime', 'leaderboardVisibility', 'activeModel',
          'cohortStartDate', 'updatedBy', 'updatedAt'
        ])
        && data.id == settingId
        && (!('questionGenerationTime' in data) || (data.questionGenerationTime is string && data.questionGenerationTime.size() <= 10))
        && data.examStartTime is string && data.examStartTime.size() <= 10
        && data.examEndTime is string && data.examEndTime.size() <= 10
        && data.answerKeyReleaseTime is string && data.answerKeyReleaseTime.size() <= 10
        && data.leaderboardVisibility in ['public', 'top_only', 'hidden_from_students']
        && (!('activeModel' in data) || (data.activeModel is string && data.activeModel.size() <= 64))
        && (!('cohortStartDate' in data) || isValidDateId(data.cohortStartDate))
        && data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidAIUsageLog(data, logId) {
      return data.keys().hasAll(['id', 'actorUid', 'operation', 'model', 'status', 'timestamp'])
        && data.keys().hasOnly(['id', 'actorUid', 'operation', 'model', 'status', 'latencyMs', 'itemsGenerated', 'timestamp'])
        && data.id == logId
        && data.actorUid == request.auth.uid
        && data.operation is string && data.operation.size() > 0 && data.operation.size() <= 64
        && data.model is string && data.model.size() > 0 && data.model.size() <= 64
        && data.status in ['success', 'rate_limited', 'error']
        && (!('latencyMs' in data) || (data.latencyMs is number && data.latencyMs >= 0))
        && (!('itemsGenerated' in data) || (data.itemsGenerated is number && data.itemsGenerated >= 0))
        && data.timestamp is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Match Rules
    // -------------------------------------------------------------------------

    // 1. User Profiles & Private Subcollections (Strict PII Isolation)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().role == 'student' || isSuperAdmin());

      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && incoming().updatedAt == request.time
        && incoming().createdAt == existing().createdAt
        && incoming().id == existing().id
        && incoming().studentId == existing().studentId
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'state', 'district', 'targetExam', 'batch',
              'dailyStreak', 'streakFreezes', 'skillTier', 'referralCode',
              'referredBy', 'badges', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && isSuperAdmin();

      // Immutable Attempt Records
      match /attempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin()) && resource.data.userId == userId;

        allow create: if isValidId(userId) && isValidId(attemptId)
          && isVerifiedOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidAttempt(incoming(), userId, attemptId)
          && incoming().submittedAt == request.time;

        allow update: if false;
        allow delete: if false;
      }

      // Dynamic Student Progress Subcollection
      match /progress/{progressId} {
        allow get: if isValidId(userId) && isValidId(progressId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin()) && resource.data.userId == userId;

        allow create: if isValidId(userId) && isValidId(progressId)
          && isVerifiedOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserProgress(incoming(), userId)
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId) && isValidId(progressId)
          && isVerifiedUser()
          && isValidUserProgress(incoming(), userId)
          && incoming().updatedAt == request.time
          && incoming().userId == existing().userId
          && (
            isAdmin()
            || (
              isOwner(userId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'testsTaken', 'averageScore', 'highestScore', 'overallAccuracy',
                'bestRank', 'currentStreak', 'longestStreak', 'streakFreezesAvailable',
                'streakFreezesUsed', 'frozenDates', 'claimedMilestones', 'lastActivityDate',
                'lastFreezeConsumedDate', 'skillTier', 'xpPoints', 'proAnalyticsUnlocked',
                'referralsCount', 'badges', 'marksLostToNegatives', 'rapidMistakesCount',
                'subjectPerformance', 'weakestTopics', 'recentAttempts', 'rolling30DayHistory',
                'updatedAt'
              ])
            )
          );

        allow delete: if false;
      }

      // Isolated Speed Practice Session History (Non-Ranking)
      match /speed_practice/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin()) && resource.data.userId == userId;

        allow create: if isValidId(userId) && isValidId(sessionId)
          && isVerifiedOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidSpeedPracticeSession(incoming(), userId, sessionId)
          && incoming().completedAt == request.time;

        allow update: if false;
        allow delete: if false;
      }
    }

    // 2. Public PII-Free Daily Leaderboard
    match /daily_exams/{examDate}/leaderboard/{studentId} {
      allow get: if isValidDateId(examDate) && isValidId(studentId) && isSignedIn();
      allow list: if isValidDateId(examDate) && isSignedIn() && resource.data.studentId is string;

      allow create: if isValidDateId(examDate) && isValidId(studentId)
        && isVerifiedUser()
        && isValidLeaderboardEntry(incoming(), studentId)
        && incoming().submittedAt == request.time;

      allow update: if isValidDateId(examDate) && isValidId(studentId)
        && isVerifiedUser()
        && isValidLeaderboardEntry(incoming(), studentId)
        && incoming().submittedAt == request.time
        && incoming().studentId == existing().studentId
        && (
          isAdmin()
          || (
            existing().userId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'studentName', 'studentState', 'score', 'correctCount', 'incorrectCount',
              'unattemptedCount', 'timeTakenSeconds', 'skillTier', 'isDisqualified', 'submittedAt'
            ])
          )
        );

      allow delete: if isValidDateId(examDate) && isValidId(studentId) && isAdmin();
    }

    // 3. Scheduled Daily & Custom Tests (Admin Authored, Signed-in Readable)
    match /scheduled_tests/{testId} {
      allow get: if isValidId(testId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.status in ['scheduled', 'live', 'closed', 'published', 'draft', 'validated'];

      allow create: if isValidId(testId)
        && isAdmin()
        && isValidScheduledTest(incoming(), testId)
        && incoming().updatedAt == request.time;

      allow update: if isValidId(testId)
        && isAdmin()
        && isValidScheduledTest(incoming(), testId)
        && incoming().updatedAt == request.time
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'testType', 'scheduledDate',
          'scheduledStartTime', 'scheduledEndTime', 'durationSeconds',
          'status', 'questions', 'updatedAt'
        ]);

      allow delete: if isValidId(testId) && isAdmin();
    }

    // 4. Previous Year Question Papers Archive
    match /pqps/{pqpId} {
      allow get: if isValidId(pqpId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.year >= 1990;

      allow create: if isValidId(pqpId)
        && isAdmin()
        && isValidPQP(incoming(), pqpId)
        && incoming().uploadedAt == request.time;

      allow update: if isValidId(pqpId)
        && isAdmin()
        && isValidPQP(incoming(), pqpId)
        && incoming().uploadedAt == request.time
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'examCategory', 'year', 'shiftLabel', 'durationSeconds', 'questions', 'uploadedAt'
        ]);

      allow delete: if isValidId(pqpId) && isAdmin();
    }

    // 5. Post-8:00 PM IST Answer Key Sheets (Time-Gated Read)
    match /key_sheets/{examDate} {
      allow get: if isValidDateId(examDate)
        && isSignedIn()
        && (isAdmin() || request.time.toMillis() >= resource.data.unlockTimestampMs);

      allow list: if isAdmin() || (isSignedIn() && request.time.toMillis() >= resource.data.unlockTimestampMs);

      allow create: if isValidDateId(examDate)
        && isAdmin()
        && isValidKeySheet(incoming(), examDate)
        && incoming().updatedAt == request.time;

      allow update: if isValidDateId(examDate)
        && isAdmin()
        && isValidKeySheet(incoming(), examDate)
        && incoming().updatedAt == request.time
        && incoming().examDate == existing().examDate
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'unlockTimestampMs', 'items', 'publishedBy', 'updatedAt'
        ]);

      allow delete: if isValidDateId(examDate) && isAdmin();
    }

    // 6. Immutable Security & Admin Audit Logs
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(logId)
        && isVerifiedUser()
        && isValidAuditLog(incoming(), logId)
        && incoming().timestamp == request.time;

      allow update: if false;
      allow delete: if false;
    }

    function isValidAdminMembership(data, uid) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'grantedBy', 'createdAt'])
        && data.uid == uid
        && data.grantedBy is string && data.grantedBy.size() > 0 && data.grantedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    // 7. Admin Registry (Checked by isAdmin())
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isSuperAdmin());
      allow list: if isSuperAdmin();

      allow create: if isValidId(uid)
        && isSuperAdmin()
        && isValidAdminMembership(incoming(), uid)
        && incoming().createdAt == request.time;

      allow update: if isValidId(uid)
        && isSuperAdmin()
        && isValidAdminMembership(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['grantedBy']);

      allow delete: if isValidId(uid) && isSuperAdmin();
    }

    // 8. Authenticated Connection Health Probe
    match /test/{docId} {
      allow get: if docId == 'connection' && isSignedIn();
      allow list, write: if false;
    }

    // 9. 100-Week Study Plan Overrides (Admin Managed, Signed-In Read)
    match /study_plan_overrides/{dayKey} {
      allow get: if isValidId(dayKey) && isSignedIn();
      allow list: if isSignedIn() && resource.data.dayKey is string;

      allow create: if isValidId(dayKey)
        && isAdmin()
        && isValidStudyPlanOverride(incoming(), dayKey)
        && incoming().updatedAt == request.time;

      allow update: if isValidId(dayKey)
        && isAdmin()
        && isValidStudyPlanOverride(incoming(), dayKey)
        && incoming().updatedAt == request.time
        && incoming().dayKey == existing().dayKey
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'subject', 'topic', 'topicDescription', 'learningObjectives',
          'approvalStatus', 'scheduledDateOverride', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if isValidId(dayKey) && isAdmin();
    }

    // 10. AI Question Review Vault (Strictly Admin Only - No Student Leakage)
    match /ai_question_vault/{questionId} {
      allow get: if isValidId(questionId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(questionId)
        && isAdmin()
        && isValidAIMCQQuestion(incoming(), questionId)
        && incoming().updatedAt == request.time;

      allow update: if isValidId(questionId)
        && isAdmin()
        && isValidAIMCQQuestion(incoming(), questionId)
        && incoming().updatedAt == request.time
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'text', 'options', 'correctIndex', 'explanation', 'subject',
          'topic', 'difficulty', 'examCategory', 'reviewStatus',
          'sourceType', 'referenceNote', 'updatedAt'
        ]);

      allow delete: if isValidId(questionId) && isAdmin();
    }

    // 11. Public Exam Schedule & Non-Secret App Settings (No Secret Keys)
    match /app_settings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.updatedAt is timestamp;

      allow create: if isValidId(settingId)
        && isAdmin()
        && isValidAppPublicSettings(incoming(), settingId)
        && incoming().updatedAt == request.time;

      allow update: if isValidId(settingId)
        && isAdmin()
        && isValidAppPublicSettings(incoming(), settingId)
        && incoming().updatedAt == request.time
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'questionGenerationTime', 'examStartTime', 'examEndTime',
          'answerKeyReleaseTime', 'leaderboardVisibility', 'activeModel',
          'cohortStartDate', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if isValidId(settingId) && isAdmin();
    }

    // 12. Admin-Only AI Usage Telemetry Logs
    match /ai_usage_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(logId)
        && isAdmin()
        && isValidAIUsageLog(incoming(), logId)
        && incoming().timestamp == request.time;

      allow update: if false;
      allow delete: if false;
    }
  }
}
